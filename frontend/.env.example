# The full URL to your backend API for the Vite dev-server proxy
VITE_API_PROXY_TARGET=http://localhost:8080

# Backend URL for the Nginx reverse proxy (Docker deployments).
# Nginx forwards /policy, /mappings, /validate to this address.
PAP_BACKEND_URL=http://odrl-pap:8080

# Override the API base URL in the browser (rarely needed).
# Leave empty to use the Nginx proxy (recommended) or the Vite dev-server proxy.
# Only set this if the frontend must call a different origin than the proxy.
# VITE_API_BASE_URL=

# Custom JSON-LD @context for new ODRL policies (JSON string).
# Defaults to {"odrl":"http://www.w3.org/ns/odrl/2/"} when not set.
# VITE_ODRL_CONTEXT={"odrl":"http://www.w3.org/ns/odrl/2/","dome-op":"https://github.com/DOME-Marketplace/dome-odrl-profile#"}
